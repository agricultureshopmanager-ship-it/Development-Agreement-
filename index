<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Service Agreement - Your Shop Manager</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  
  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    font-size: 11pt;
    line-height: 1.6;
    color: #2d3748;
    background: #f7fafc;
    padding: 20px 10px;
  }
  
  .page {
    max-width: 800px;
    margin: 0 auto;
    background: #ffffff;
    padding: 60px 50px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.1);
  }
  
  /* Header Section */
  .header {
    text-align: center;
    border-bottom: 3px solid #4a5568;
    padding-bottom: 40px;
    margin-bottom: 50px;
  }
  
  .header-subtitle {
    font-size: 10pt;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #718096;
    margin-bottom: 15px;
    font-weight: 500;
  }
  
  .header-title {
    font-size: 32pt;
    font-weight: 700;
    color: #1a202c;
    margin-bottom: 10px;
    letter-spacing: -0.5px;
  }
  
  .header-brand {
    font-size: 14pt;
    color: #4a5568;
    font-weight: 600;
    margin-top: 15px;
  }
  
  /* Parties Section */
  .parties {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 50px;
    margin-bottom: 50px;
    padding: 30px;
    background: #f7fafc;
    border-radius: 8px;
  }
  
  .party-block h3 {
    font-size: 9pt;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #718096;
    margin-bottom: 15px;
    font-weight: 600;
  }
  
  .party-block .name {
    font-size: 13pt;
    font-weight: 600;
    color: #2d3748;
    margin-bottom: 8px;
  }
  
  .party-block .detail {
    font-size: 10.5pt;
    color: #4a5568;
    margin-bottom: 5px;
    line-height: 1.5;
    word-wrap: break-word;
  }
  
  .party-block .blank-field {
    display: inline-block;
    min-width: 150px;
    border-bottom: 1px solid #cbd5e0;
    color: #a0aec0;
  }
  
  /* Agreement Date */
  .agreement-date {
    margin-bottom: 40px;
    padding: 20px;
    background: #edf2f7;
    border-left: 4px solid #4299e1;
    border-radius: 4px;
  }
  
  .agreement-date p {
    font-size: 11pt;
    color: #2d3748;
  }
  
  .agreement-date .blank-line {
    display: inline-block;
    min-width: 150px;
    border-bottom: 1px solid #4a5568;
    padding: 0 5px;
  }
  
  /* Section Styling */
  .section {
    margin-bottom: 35px;
  }
  
  .section-header {
    display: flex;
    align-items: center;
    margin-bottom: 20px;
    padding-bottom: 10px;
    border-bottom: 2px solid #e2e8f0;
  }
  
  .section-number {
    background: #4a5568;
    color: white;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 10pt;
    margin-right: 15px;
    flex-shrink: 0;
  }
  
  .section-title {
    font-size: 13pt;
    font-weight: 700;
    color: #2d3748;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  
  .section-content {
    padding-left: 10px;
  }
  
  /* Lists */
  ol {
    padding-left: 30px;
    margin-bottom: 15px;
  }
  
  li {
    margin-bottom: 12px;
    font-size: 10.5pt;
    line-height: 1.7;
    color: #4a5568;
    word-wrap: break-word;
  }
  
  /* Inline blanks */
  .inline-blank {
    display: inline-block;
    min-width: 120px;
    border-bottom: 1px solid #cbd5e0;
    margin: 0 5px;
  }
  
  .inline-blank.short {
    min-width: 80px;
  }
  
  .inline-blank.long {
    min-width: 200px;
  }
  
  /* Checkboxes */
  .checkbox-item {
    display: inline-flex;
    align-items: center;
    margin-right: 25px;
    margin-bottom: 10px;
  }
  
  .checkbox {
    width: 18px;
    height: 18px;
    border: 2px solid #cbd5e0;
    border-radius: 3px;
    margin-right: 8px;
    flex-shrink: 0;
  }
  
  .checkbox-label {
    font-size: 10.5pt;
    color: #4a5568;
  }
  
  /* Feature List */
  .feature-list {
    list-style: none;
    padding-left: 0;
  }
  
  .feature-list li {
    padding-left: 20px;
    position: relative;
  }
  
  .feature-list li:before {
    content: "•";
    color: #4299e1;
    font-weight: bold;
    position: absolute;
    left: 0;
  }
  
  /* Signature Section */
  .signature-section {
    margin-top: 70px;
    padding-top: 50px;
    border-top: 3px solid #4a5568;
  }
  
  .signature-title {
    font-size: 13pt;
    font-weight: 700;
    color: #2d3748;
    margin-bottom: 10px;
    text-align: center;
  }
  
  .signature-subtitle {
    text-align: center;
    color: #718096;
    font-size: 10.5pt;
    margin-bottom: 40px;
  }
  
  .signatures {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    margin-top: 50px;
  }
  
  .signature-block {
    margin-bottom: 30px;
  }
  
  .signature-label {
    font-size: 9pt;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #718096;
    margin-bottom: 15px;
    font-weight: 600;
  }
  
  .signature-line {
    border-bottom: 2px solid #2d3748;
    height: 50px;
    margin-bottom: 10px;
  }
  
  .signature-name {
    font-size: 10.5pt;
    color: #4a5568;
    font-weight: 600;
  }
  
  .signature-date {
    margin-top: 20px;
    font-size: 10pt;
    color: #4a5568;
  }
  
  .signature-date .blank-line {
    display: inline-block;
    min-width: 120px;
    border-bottom: 1px solid #cbd5e0;
    margin-left: 10px;
  }
  
  /* Footer */
  .footer {
    margin-top: 60px;
    padding-top: 30px;
    border-top: 1px solid #e2e8f0;
    text-align: center;
    font-size: 9pt;
    color: #a0aec0;
  }
  
  .footer strong {
    color: #718096;
    font-weight: 600;
  }
  
  /* Highlight Box */
  .highlight-box {
    background: #fffaf0;
    border-left: 4px solid #ed8936;
    padding: 15px 20px;
    margin: 20px 0;
    border-radius: 4px;
  }
  
  .highlight-box p {
    font-size: 10.5pt;
    color: #744210;
    margin: 0;
  }
  
  /* Print Button */
  .print-btn {
    position: fixed;
    top: 20px;
    right: 20px;
    background: #4299e1;
    color: white;
    border: none;
    padding: 15px 30px;
    font-family: inherit;
    font-size: 11pt;
    font-weight: 600;
    border-radius: 8px;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(66, 153, 225, 0.4);
    transition: all 0.3s;
    z-index: 1000;
  }
  
  .print-btn:hover {
    background: #3182ce;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(66, 153, 225, 0.5);
  }
  
  /* MOBILE RESPONSIVE */
  @media screen and (max-width: 768px) {
    body {
      padding: 10px 5px;
    }
    
    .page {
      padding: 40px 25px;
    }
    
    .header-title {
      font-size: 24pt;
    }
    
    .header-subtitle {
      font-size: 9pt;
      letter-spacing: 2px;
    }
    
    .header-brand {
      font-size: 12pt;
    }
    
    .parties {
      grid-template-columns: 1fr;
      gap: 30px;
      padding: 20px;
    }
    
    .party-block .blank-field {
      min-width: 100px;
    }
    
    .section-title {
      font-size: 11pt;
    }
    
    .section-number {
      width: 28px;
      height: 28px;
      font-size: 9pt;
    }
    
    .inline-blank {
      min-width: 80px;
    }
    
    .inline-blank.long {
      min-width: 150px;
    }
    
    .signatures {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    
    .checkbox-item {
      display: flex;
      margin-right: 0;
      margin-bottom: 8px;
    }
    
    .print-btn {
      top: 10px;
      right: 10px;
      padding: 12px 20px;
      font-size: 10pt;
    }
    
    ol {
      padding-left: 20px;
    }
    
    li {
      font-size: 10pt;
    }
  }
  
  /* Print Styles */
  @media print {
    body {
      background: white;
      padding: 0;
    }
    
    .page {
      box-shadow: none;
      padding: 50px 40px;
      max-width: 100%;
    }
    
    .print-btn {
      display: none !important;
    }
    
    @page {
      margin: 1cm;
      size: A4;
    }
  }
</style>
</head>
