<script>
function handlePrint() {
  // Check if on mobile
  if (window.innerWidth <= 768) {
    // On mobile, show instructions
    alert('To save as PDF on mobile:\n\n1. Tap the Share button in your browser\n2. Select "Print"\n3. Choose "Save as PDF" as the printer\n\nOr open this page on a desktop computer for easier PDF generation.');
  } else {
    // On desktop, trigger print
    window.print();
  }
}
</script>

